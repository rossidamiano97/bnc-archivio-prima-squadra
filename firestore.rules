rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function admin(){ return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true; }
  function validStatus(){ return request.resource.data.status in ['draft','published','archived']; }
  match /admins/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
  match /auditLogs/{id} { allow read,create: if admin(); allow update,delete: if false; }
  // Le regole di match si sommano (OR): il blocco generico NON deve valere per admins e auditLogs,
  // altrimenti annulla i divieti di scrittura definiti sopra.
  function generic(collection){ return collection != 'admins' && collection != 'auditLogs'; }
  match /{collection}/{document=**} {
   allow read: if generic(collection) && (resource.data.status == 'published' || admin());
   allow create,update: if generic(collection) && admin() && validStatus();
   allow delete: if generic(collection) && admin();
  }
 }
}